# 共创智能体平台后端配置
# 基础配置
PROJECT_NAME=共创智能体平台 API
VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001

# JWT 配置（独立密钥，与主平台不同）
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库配置
DATABASE_URL=sqlite:///./cocreation.db
JSON_REQUEST_MAX_BYTES=2097152
# 默认关闭。仅在部署已审计且满足最低版本的 Pillow/pypdf 后显式开启。
ENABLE_TRUSTED_MEDIA_PIPELINE=false

# CORS 配置（前端地址）
ALLOWED_ORIGINS_STR=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 文件上传配置
UPLOAD_PATH=uploads
UPLOAD_MAX_SIZE=104857600

# CAD AI 统一网关
CAD_AI_BASE_URL=
CAD_AI_API_KEY=
CAD_AI_TIMEOUT_SECONDS=240

# AI 模型配置
DASHSCOPE_API_KEY=
LOCAL_QWEN_BASE_URL=http://127.0.0.1:58080/v1
LOCAL_QWEN_API_KEY=local-qwen
LOCAL_QWEN_MODEL=/data/models/Qwen3-32B-INT8

# 主平台 SSO 配置
MAIN_PLATFORM_URL=http://localhost:8000
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8001/api/v1/auth/sso/callback

# NodAPI
NODAPI_BASE_URL=https://www.nodapi.com
NODAPI_API_KEY=
NODAPI_CHAT_MODEL=gpt-4o-mini
NODAPI_CHAT_TIMEOUT_SECONDS=120
NODAPI_IMAGE_MODEL=gpt-image-2
NODAPI_IMAGE_SIZE=1536x1024
NODAPI_IMAGE_TIMEOUT_SECONDS=240

# Zoo / KittyCAD
ZOO_API_BASE_URL=https://api.zoo.dev
ZOO_API_TOKEN=
